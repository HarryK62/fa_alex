# Alex Financial Planner (local only) - environment variables
# Copy this file to .env and fill in your values. Nothing here talks to AWS.

# Required: OpenAI runs every agent and creates the knowledge-base embeddings
OPENAI_API_KEY=sk-...

# Optional model overrides
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # keep a 1536-dimension model

# Clerk configuration for JWT validation (sign-in)
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Local Postgres + pgvector (docker-compose.yml). This is the default.
# DATABASE_URL=postgresql://alex:alex@localhost:5432/alex

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Share prices come from Yahoo Finance via yfinance. No key needed.
# ASX tickers use the .AX suffix (e.g. BHP.AX) and are priced in AUD.

# Optional: Langfuse tracing
# Create a free project at https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development
